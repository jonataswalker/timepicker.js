{
    "name": "timepicker.js",
    "version": "5.0.1",
    "description": "A lightweight, customizable, TimePicker",
    "author": {
        "name": "Jonatas Walker",
        "email": "jonataswalker@gmail.com"
    },
    "homepage": "https://github.com/jonataswalker/timepicker.js",
    "license": "MIT",
    "type": "module",
    "jsdelivr": "./dist/timepicker.iife.js",
    "exports": "./dist/timepicker.js",
    "types": "./dist/timepicker.d.ts",
    "files": [
        "dist"
    ],
    "engines": {
        "node": "^22 || ^24 || ^26",
        "npm": ">=10"
    },
    "scripts": {
        "dev": "vite --port 4000",
        "build": "rimraf ./dist && vite build && vite build --mode iife",
        "preview": "vite preview",
        "typecheck": "npm run check:typecheckers && npm run typecheck:tsrs && npm run typecheck:ts7",
        "lint": "oxlint",
        "lint:fix": "npm run lint -- --fix",
        "format": "oxfmt .",
        "format:check": "oxfmt --check .",
        "test": "playwright test",
        "test:ui": "playwright test --ui",
        "check:package": "attw --pack . --profile esm-only && publint && node scripts/check-pack.mjs && node scripts/check-consumers.mjs",
        "verify": "npm run typecheck && npm run lint && npm run format:check && npm test && npm run build && npm run check:package",
        "prepare": "husky",
        "release": "release-it --no-npm.publish",
        "typecheck:tsrs": "tsrs --noEmit -p .",
        "typecheck:ts7": "node ./node_modules/typescript/bin/tsc --noEmit -p .",
        "check:typecheckers": "node scripts/check-typecheckers.mjs",
        "check:typecheck-parity": "node scripts/check-typecheck-parity.mjs"
    },
    "repository": {
        "type": "git",
        "url": "git+https://github.com/jonataswalker/timepicker.js.git"
    },
    "bugs": {
        "url": "https://github.com/jonataswalker/timepicker.js/issues"
    },
    "devDependencies": {
        "@arethetypeswrong/cli": "^0.18.5",
        "@microsoft/api-extractor": "^7.60.1",
        "@playwright/test": "^1.65.1",
        "@types/node": "^26.6.6",
        "@typescript/typescript6": "^6.0.2",
        "auto-changelog": "^2.7.0",
        "husky": "^9.1.7",
        "oxfmt": "^0.78.0",
        "oxlint": "^1.93.0",
        "oxlint-config-jwalker": "^0.2.1",
        "publint": "^0.3.25",
        "release-it": "^21.1.2",
        "rimraf": "^6.1.4",
        "sass": "^1.108.2",
        "tsrs": "7.1.0-beta.tsrs2",
        "typescript": "^7.0.2",
        "vite": "^8.3.8",
        "vite-plugin-banner": "^0.8.1",
        "vite-plugin-css-injected-by-js": "^5.0.3",
        "vite-plugin-dts": "^5.1.2"
    },
    "dependencies": {
        "mitt": "^3.0.1"
    },
    "overrides": {
        "basic-ftp": "^6.2.6",
        "minimatch": "^11.0.8"
    },
    "funding": "https://github.com/sponsors/jonataswalker"
}
